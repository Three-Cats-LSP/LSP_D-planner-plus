{
  "schema_version": 3,
  "repeat": 2,
  "cycle": 21,
  "subcycle": "2c",
  "traces": [
    {
      "id": "SL-MODE-REC-TEC-ISOLATION",
      "case_ids": ["SL-MODE-REC-TEC-ISOLATION"],
      "entry_event": "User switches Rec ↔ Bühlmann; each mode retains its own depth/BT via view snapshots.",
      "consumer_path": ["navBtnBuh click", "setPlannerAlgo view swap", "onPlannerViewSwitch restore", "tecDepth value persisted"],
      "setup": [
        {"action": "set_global", "name": "_zhlHeadless", "value": false},
        {"action": "run_script", "setup_only_reason": "Prime disjoint REC/TECH depth/BT values on hidden inputs before visible nav-only steps.",
          "script": "() => { setPlannerAlgo('ZHLC_GF'); const td = document.getElementById('tecDepth'); const tb = document.getElementById('tecBT'); if (td) td.value = '44'; if (tb) tb.value = '22'; _syncTecDepthBtSteppers?.(); setPlannerAlgo('rec'); const rd = document.getElementById('recDepth'); const rb = document.getElementById('recBT'); if (rd) rd.value = '33'; if (rb) rb.value = '21'; _syncRecDepthBtSteppers?.(); }"
        }
      ],
      "state": {
        "selectors": ["#navBtnRec", "#navBtnBuh", "#tecDepthBtSteppers button[aria-label=\"Increase depth\"]"],
        "restore_order": ["#tecDepthBtSteppers button[aria-label=\"Increase depth\"]", "#navBtnRec", "#navBtnBuh"],
        "globals": ["_zhlHeadless"]
      },
      "steps": [
        {"capture": "before", "values": {
          "rec_d": "document.getElementById('recDepth')?.value",
          "tec_d": "document.getElementById('tecDepth')?.value"
        }},
        {"action": "click", "selector": "#navBtnBuh"},
        {"capture": "tec_restored", "values": {
          "tec_d": "document.getElementById('tecDepth')?.value",
          "tec_b": "document.getElementById('tecBT')?.value",
          "rec_visible": "document.getElementById('recPlannerView')?.classList.contains('visible')",
          "tec_visible": "document.getElementById('tecPlannerView')?.classList.contains('visible')"
        }},
        {"action": "click", "selector": "#tecDepthBtSteppers button[aria-label=\"Increase depth\"]"},
        {"capture": "tec_edited", "values": {
          "tec_d": "document.getElementById('tecDepth')?.value",
          "tec_lbl": "document.getElementById('tecDepthStepperVal')?.textContent"
        }},
        {"action": "click", "selector": "#navBtnRec"},
        {"capture": "rec_restored", "values": {
          "rec_d": "document.getElementById('recDepth')?.value",
          "rec_b": "document.getElementById('recBT')?.value"
        }},
        {"action": "click", "selector": "#navBtnBuh"},
        {"capture": "tec_persisted", "values": {
          "tec_d": "document.getElementById('tecDepth')?.value"
        }}
      ],
      "assertions": [
        {"id": "tec-view-visible", "left": "$.tec_restored.tec_visible", "op": "equal", "right": true},
        {"id": "rec-hidden-on-tec", "left": "$.tec_restored.rec_visible", "op": "equal", "right": false},
        {"id": "tec-depth-restored", "left": "$.tec_restored.tec_d", "op": "equal", "right": "44"},
        {"id": "rec-depth-restored", "left": "$.rec_restored.rec_d", "op": "equal", "right": "33"},
        {"id": "tec-depth-edited-persists", "left": "$.tec_persisted.tec_d", "op": "equal", "right": "45"}
      ]
    }
  ]
}
